# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/caresync_local

# ---------------------------------------------------------------------------
# External API keys
# Leave a key blank until you have it: the app starts without them and the
# matching feature reports "not configured" instead of failing with bad
# credentials.
# ---------------------------------------------------------------------------

# Twilio (used by ElevenLabs for outbound calls + SMS fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ElevenLabs Conversational AI
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_BLOOD_AGENT_ID=
# Blood requests: donors/orgs called at once (0 = by urgency)
BLOOD_BATCH_SIZE=3
# Secret for the agent's live slot tools (any long random string; set the same
# value as the X-Tool-Secret header on both tools in the ElevenLabs dashboard)
ELEVENLABS_TOOL_SECRET=

# Gmail SMTP (OTP + email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Google Calendar direct API token (calendar event creation for bookings)
GOOGLE_CALENDAR_ACCESS_TOKEN=

# Google Calendar OAuth (each doctor connects their own calendar in Settings).
# Add GOOGLE_OAUTH_REDIRECT_URI as an "Authorized redirect URI" on the OAuth
# client in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/google/oauth/callback
FRONTEND_BASE_URL=http://localhost:3000

# Google Gemini (lab report / document extraction)
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (AI workflow builder)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v3.2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Deepgram (speech-to-text in the workflow builder)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# App
APP_BASE_URL=http://localhost:8000
CLINIC_TIMEZONE=Asia/Kolkata

# Follow-up scheduler
FOLLOW_UP_CRON_ENABLED=true
FOLLOW_UP_CRON_DELAY_MINUTES=1
FOLLOW_UP_CRON_POLL_INTERVAL_SECONDS=15
FOLLOW_UP_CRON_MAX_ATTEMPTS=3
FOLLOW_UP_CRON_BATCH_SIZE=10

# NGO portal (optional; defaults shown)
NGO_SESSION_TTL_HOURS=12
NGO_CSV_MAX_BYTES=2097152
NGO_CSV_MAX_ROWS=2000
NGO_IMPORT_PREVIEW_TTL_HOURS=24

# Video consultations (browser-to-browser WebRTC). Optional TURN relay for
# networks that block direct connections, e.g. turn:turn.example.com:3478
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# Patient SMS + email notifications for bookings, reschedules and cancellations
NOTIFY_PATIENTS_SMS=true
NOTIFY_PATIENTS_EMAIL=true

# Blood requests: SMS donors/organizations/contact person and email the doctor
NOTIFY_BLOOD_SMS=true
NOTIFY_BLOOD_EMAIL=true
