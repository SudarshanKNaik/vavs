# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/caresync_local

# ---------------------------------------------------------------------------
# External API keys
# Leave a key blank until you have it: the app starts without them and the
# matching feature reports "not configured" instead of failing with bad
# credentials.
# ---------------------------------------------------------------------------

# Twilio (used by ElevenLabs for outbound calls + SMS fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ElevenLabs Conversational AI
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=

# Gmail SMTP (OTP + email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Google Calendar direct API token (calendar event creation for bookings)
GOOGLE_CALENDAR_ACCESS_TOKEN=

# Google Gemini (lab report / document extraction)
GOOGLE_GEMINI_API_KEY=

# OpenRouter (AI workflow builder)
OPENROUTER_API_KEY=

# Deepgram (speech-to-text in the workflow builder)
DEEPGRAM_API_KEY=

# App base URL (used for webhook callback URLs)
APP_BASE_URL=http://localhost:8000
